# --- Database (PostgreSQL) ---
# Local: matches docker-compose.yml. Production: use your managed Postgres URL (Neon, Supabase, RDS, Vercel Postgres).
DATABASE_URL="postgresql://certready:certready@localhost:5433/certready?schema=public"

# --- App ---
# Public origin, no trailing slash. Used for canonical URLs, sitemap, Open Graph, and password-reset links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Auth ---
# 32+ random bytes, base64. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
# Days a login session stays valid.
SESSION_TTL_DAYS="30"

# --- Email (password reset) ---
# Leave blank in development: reset links are printed to the server console instead of sent.
# Any SMTP provider works (Resend, Postmark, SES). RESEND_API_KEY is read first if present.
RESEND_API_KEY=""
EMAIL_FROM="CertReady <no-reply@certready.com>"

# --- Admin bootstrap ---
# The seed script creates this admin account if no admin exists.
ADMIN_EMAIL="admin@certready.local"
ADMIN_PASSWORD="ChangeMe123!"

# --- Google OAuth (Phase 2, not yet wired) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Stripe (architecture only, not yet wired) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Analytics / Ads (render nothing when blank) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
